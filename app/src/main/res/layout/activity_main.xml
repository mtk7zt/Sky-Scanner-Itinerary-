<?xml version="1.0" encoding="utf-8"?>
<!--
    Retains the original three Backpack cards and sample flight data.
    Extensions: connected constraints, scrolling, resource-based text,
    Backpack colours, airport names, and improved spacing.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/flightRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bpkCanvasContrast"
    android:fillViewport="true"
    android:clipToPadding="false">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp">

        <!-- Header -->
        <LinearLayout
            android:id="@+id/header"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <net.skyscanner.backpack.text.BpkText
                style="@style/FsHeading"
                android:text="@string/fs_brand"
                android:textColor="@color/bpkTextLink"
                android:textSize="22sp" />

            <net.skyscanner.backpack.text.BpkText
                style="@style/FsHeading"
                android:layout_marginTop="20dp"
                android:accessibilityHeading="true"
                android:text="@string/fs_title"
                android:textSize="28sp" />

            <net.skyscanner.backpack.text.BpkText
                style="@style/FsBody"
                android:layout_marginTop="8dp"
                android:text="@string/fs_subtitle" />

        </LinearLayout>

        <!-- Original flight card, extended with a route summary. -->
        <net.skyscanner.backpack.card.BpkCardView
            android:id="@+id/flightCard"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            app:cardBackgroundColor="@color/bpkCorePrimary"
            app:cornerStyle="large"
            app:elevationLevel="normal"
            app:padded="false"
            app:layout_constraintTop_toBottomOf="@id/header"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <net.skyscanner.backpack.text.BpkText
                    style="@style/FsHeading"
                    android:accessibilityHeading="true"
                    android:text="@string/fs_flight"
                    android:textColor="@color/bpkTextOnDark"
                    android:textSize="20sp" />

                <net.skyscanner.backpack.text.BpkText
                    style="@style/FsHeading"
                    android:layout_marginTop="12dp"
                    android:text="@string/fs_flight_number"
                    android:textColor="@color/bpkTextOnDark"
                    android:textSize="36sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="16dp"
                    android:background="@color/bpkLineOnDark"
                    android:importantForAccessibility="no" />

                <net.skyscanner.backpack.text.BpkText
                    style="@style/FsBody"
                    android:text="@string/fs_route"
                    android:textColor="@color/bpkTextOnDark"
                    android:textSize="18sp" />

            </LinearLayout>

        </net.skyscanner.backpack.card.BpkCardView>

        <!-- Original departure card. -->
        <net.skyscanner.backpack.card.BpkCardView
            android:id="@+id/departureCard"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:cardBackgroundColor="@color/bpkSurfaceDefault"
            app:cornerStyle="large"
            app:elevationLevel="normal"
            app:padded="false"
            app:layout_constraintTop_toBottomOf="@id/flightCard"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <net.skyscanner.backpack.text.BpkText
                    style="@style/FsHeading"
                    android:accessibilityHeading="true"
                    android:text="@string/fs_departure" />

                <net.skyscanner.backpack.text.BpkText
                    style="@style/FsAirportCode"
                    android:layout_marginTop="12dp"
                    android:text="@string/fs_departure_code" />

                <net.skyscanner.backpack.text.BpkText
                    style="@style/FsBody"
                    android:layout_marginTop="4dp"
                    android:text="@string/fs_departure_airport" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="16dp"
                    android:background="@color/bpkLine"
                    android:importantForAccessibility="no" />

                <net.skyscanner.backpack.text.BpkText
                    style="@style/FsTime"
                    android:text="@string/fs_departure_time" />

                <net.skyscanner.backpack.text.BpkText
                    style="@style/FsBody"
                    android:layout_marginTop="4dp"
                    android:text="@string/fs_local_time" />

            </LinearLayout>

        </net.skyscanner.backpack.card.BpkCardView>

        <!-- Original arrival card. -->
        <net.skyscanner.backpack.card.BpkCardView
            android:id="@+id/arrivalCard"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:cardBackgroundColor="@color/bpkSurfaceDefault"
            app:cornerStyle="large"
            app:elevationLevel="normal"
            app:padded="false"
            app:layout_constraintTop_toBottomOf="@id/departureCard"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <net.skyscanner.backpack.text.BpkText
                    style="@style/FsHeading"
                    android:accessibilityHeading="true"
                    android:text="@string/fs_arrival" />

                <net.skyscanner.backpack.text.BpkText
                    style="@style/FsAirportCode"
                    android:layout_marginTop="12dp"
                    android:text="@string/fs_arrival_code" />

                <net.skyscanner.backpack.text.BpkText
                    style="@style/FsBody"
                    android:layout_marginTop="4dp"
                    android:text="@string/fs_arrival_airport" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="16dp"
                    android:background="@color/bpkLine"
                    android:importantForAccessibility="no" />

                <net.skyscanner.backpack.text.BpkText
                    style="@style/FsTime"
                    android:text="@string/fs_arrival_time" />

                <net.skyscanner.backpack.text.BpkText
                    style="@style/FsBody"
                    android:layout_marginTop="4dp"
                    android:text="@string/fs_local_time" />

            </LinearLayout>

        </net.skyscanner.backpack.card.BpkCardView>

        <net.skyscanner.backpack.text.BpkText
            android:id="@+id/footer"
            style="@style/FsBody"
            android:layout_width="0dp"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:text="@string/fs_footer"
            android:textSize="12sp"
            app:layout_constraintTop_toBottomOf="@id/arrivalCard"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>